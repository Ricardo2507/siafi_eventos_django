[Unit]
Description=Gunicorn - SIAFI Eventos Django
After=network.target

[Service]
User=deploy
Group=www-data
WorkingDirectory=/var/www/siafi_eventos_django
EnvironmentFile=/var/www/siafi_eventos_django/.env
ExecStart=/var/www/siafi_eventos_django/.venv/bin/gunicorn --workers 3 --bind unix:/run/siafi_eventos.sock siafi_eventos.wsgi:application
Restart=always

[Install]
WantedBy=multi-user.target
