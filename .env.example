# Copie este arquivo para .env na VPS e preencha os valores reais.
# Nunca suba o arquivo .env real para o Git.

SECRET_KEY=troque-por-uma-chave-forte-gerada-com-django
DEBUG=False

# Exemplo: ALLOWED_HOSTS=seudominio.com.br,www.seudominio.com.br,123.123.123.123
ALLOWED_HOSTS=seudominio.com.br,www.seudominio.com.br,IP_DA_VPS
CSRF_TRUSTED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

DB_ENGINE=django.db.backends.postgresql
DB_NAME=siafi_eventos_db
DB_USER=siafi_eventos_user
DB_PASSWORD=troque-esta-senha
DB_HOST=localhost
DB_PORT=5432

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
